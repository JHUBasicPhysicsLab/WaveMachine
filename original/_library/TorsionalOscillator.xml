<Osejs.Model.Evolution>
<Osejs.Model.Evolution.Page>
<Type>ODE_EDITOR</Type>
<Name>EvolutionPage</Name>
<Active>true</Active>
<Visible>true</Visible>
<Content>
<IndependentVariable>t</IndependentVariable>
<Increment>0.1</Increment>
<Rate state="x[i]">v[i]</Rate>
<Rate state="v[i]">f(i,x,v)</Rate>
<Rate state="phi">freq</Rate>
<Rate state="freq">sweeprate1</Rate>
<Method>RungeKuttaFehlberg</Method>
<Tolerance>0.001</Tolerance>
<Comment><![CDATA[]]></Comment>

</Content>
</Osejs.Model.Evolution.Page>
</Osejs.Model.Evolution>
<Osejs.Model.Constraints>
<Osejs.Model.Constraints.Page>
<Type>CODE_EDITOR</Type>
<Name>Constraints</Name>
<Active>true</Active>
<Visible>true</Visible>
<Content>
<Comment><![CDATA[]]></Comment>
<Code><![CDATA[
KineticEnergy=0;
for (int i=0; i<n ; i++) {
  KineticEnergy+=v[i]*v[i]/2;
}

PotentialEnergy=0;
for (int i=0; i<n ; i++) {
  PotentialEnergy+=k0*x[i]*x[i]/2;
  if (i>0) PotentialEnergy+=k*(x[i]-x[i-1])*(x[i]-x[i-1])/2;
}

TotalEnergy = PotentialEnergy+KineticEnergy;

DissipationRate=0;
for (int i=0; i<n ; i++) {
  DissipationRate+=b*v[i]*v[i];
}

if (RightEndClamped) {
  x[n-1]=0;
  v[n-1]=0;
}
]]></Code>

</Content>
</Osejs.Model.Constraints.Page>
</Osejs.Model.Constraints>
<Osejs.Model.Library>
<Osejs.Model.Library.Page>
<Type>LIBRARY_EDITOR</Type>
<Name>Forces</Name>
<Active>true</Active>
<Visible>true</Visible>
<Content>
<Comment><![CDATA[]]></Comment>
<Code><![CDATA[
public double f(int i, double x[], double v[]) {
	double force = -k0*x[i] -b*v[i];
	if (i>0) force += k*(x[i-1]-x[i]);
	if (i<n-1) force += k*(x[i+1]-x[i]);
	if (i==0) force += ampl*Math.cos(phi);
	return force;
}

public void ToggleClamping() {
	RightEndClamped = !RightEndClamped;
}
]]></Code>

</Content>
